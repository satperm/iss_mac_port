+void MVKShaderLibrary::ensureLazyLibrary() {
+	if ( !_lazy || _lazyDone.load(std::memory_order_acquire) ) { return; }
+	std::lock_guard<std::mutex> lock(_lazyLock);
+	if (_lazyDone.load(std::memory_order_relaxed)) { return; }
+	string msl;
